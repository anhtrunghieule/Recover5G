         smf_sess_t *sess, ogs_sbi_stream_t *stream,
         int state, ogs_sbi_message_t *recvmsg)
@@ -48,7 +94,8 @@ bool smf_namf_comm_handle_n1_n2_message_transfer(
  * to apply QoS updates without waiting for V-SMF or RAN setup.
