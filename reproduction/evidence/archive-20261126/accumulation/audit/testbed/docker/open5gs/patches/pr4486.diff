+                        const char *admin_key =
+                            ogs_yaml_iter_key(&admin_iter);
+                        ogs_assert(admin_key);
+                        if (!strcmp(admin_key, "enabled")) {
+                            const char *v =
+                                ogs_yaml_iter_value(&admin_iter);
+                            if (v && (!strcmp(v, "true") ||
+                                        !strcmp(v, "yes") ||
+                                        !strcmp(v, "1")))
+                                self.admin_config.enabled = true;
