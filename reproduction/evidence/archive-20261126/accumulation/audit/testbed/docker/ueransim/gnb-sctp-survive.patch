+
+void NgapTask::r5gReconnect()
+{
+    bool any = false;
+    for (auto &amfCtx : m_amfCtx)
+    {
+        if (amfCtx.second->state != EAmfState::NOT_CONNECTED)
+            continue;
+        any = true;
+        auto close = std::make_unique<NmGnbSctp>(NmGnbSctp::CONNECTION_CLOSE);
+        close->clientId = amfCtx.second->ctxId;
+        m_base->sctpTask->push(std::move(close));
+        auto msg = std::make_unique<NmGnbSctp>(NmGnbSctp::CONNECTION_REQUEST);
+        msg->clientId = amfCtx.second->ctxId;
+        msg->localAddress = m_base->config->ngapIp;
+        msg->localPort = 0;
+        msg->remoteAddress = amfCtx.second->address;
+        msg->remotePort = amfCtx.second->port;
+        msg->ppid = sctp::PayloadProtocolId::NGAP;
+        msg->associatedTask = this;
+        m_base->sctpTask->push(std::move(msg));
+    }
+    m_reconnectPending = any;
+    if (any)
+        setTimer(TIMER_ID_R5G_RECONNECT, 2000);
 }
 
