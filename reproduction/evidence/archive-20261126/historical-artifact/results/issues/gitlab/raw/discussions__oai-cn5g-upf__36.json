"status_tooltip_html": "<span class=\"user-status-emoji has-tooltip\" title=\"\" data-html=\"true\" data-placement=\"top\"><gl-emoji title=\"speech balloon\" data-name=\"speech_balloon\" data-unicode-version=\"6.0\">\ud83d\udcac</gl-emoji></span>",
