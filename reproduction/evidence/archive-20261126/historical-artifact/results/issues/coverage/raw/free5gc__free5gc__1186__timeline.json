/repos/free5gc/smf/issues/comments{/number}","contents_url":"https://api.github.com/repos/free5gc/smf/contents/{+path}","compare_url":"https://api.github.com/repos/free5gc/smf/compare/{base}...{head}","merges_url":"https://api.github.com/repos/free5gc/smf/merges","archive_url":"https://api.github.com/repos/free5gc/smf/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/free5gc/smf/downloads","issues_url":"https://api.github.com/repos/free5gc/smf/issues{/number}","pulls_url":"https://api.github.com/repos/free5gc/smf/pulls{/number}","milestones_url":"https://api.github.com/repos/free5gc/smf/milestones{/number}","notifications_url":"https://api.github.com/repos/free5gc/smf/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/free5gc/smf/labels{/name}","releases_url":"https://api.github.com/repos/free5gc/smf/releases{/id}","deployments_url":"https://api.github.com/repos/free5gc/smf/deployments","created_at":"2020-04-26T19:53:06Z","updated_at":"2026-11-05T07:50:57Z","pushed_at":"2026-11-05T07:50:51Z","git_url":"git://github.com/free5gc/smf.git","ssh_url":"git@github.com:free5gc/smf.git","clone_url":"https://github.com/free5gc/smf.git","svn_url":"https://github.com/free5gc/smf","homepage":null,"size":11257,"stargazers_count":26,"watchers_count":26,"language":"Go","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":false,"has_discussions":false,"forks_count":142,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":14,"license":{"key":"apache-2.0","name":"Apache License 2.0","spdx_id":"Apache-2.0","url":"https://api.github.com/licenses/apache-2.0","node_id":"MDc6TGljZW5zZTI="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":142,"open_issues":14,"watchers":26,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/free5gc/smf/pulls/250","html_url":"https://github.com/free5gc/smf/pull/250","diff_url":"https://github.com/free5gc/smf/pull/250.diff","patch_url":"https://github.com/free5gc/smf/pull/250.patch","merged_at":"2026-10-19T02:58:54Z"},"body":"Assisted-by: GLM-5.3-Flash\n\n When `HandlePDUSessionSMContextLocalRelease` fails to delete the PFCP session, its `SessionReleaseFailed`/`default` branches only reverted the SM context to Active - no CHARGING_RELEASE, no removal - and since the duplicate-key create caller overwrites the (SUPI, pduSessionId) key right after, that context becomes an unreachable zombie and its charging session stays open on the CHF. \n\n\nThis PR makes those branches complete the release exactly like the success branch (`ReleaseChargingSession` + `RemoveSMContextFromAllNF`), and adds a guard at the top of `RemoveSMContextFromAllNF` that releases any charging session the caller has not closed (`ChargingDataRef != \"\"`), which also covers the failed branch of `HandlePDUSessionSMContextRelease`; the existing one-shot `BeginChargingRelease()` guard keeps everything idempotent.\n\nComplete bundle for this issue (analysis report, PoC, pkgs/fix.patch, Dockerfile, compose deploy files): https://github.com/hackeryounow/IssuesFixed/tree/main/free5gc-1186\n\n\n\nFixes free5gc/free5gc#1186.","reactions":{"url":"https://api.github.com/repos/free5gc/smf/issues/250/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/free5gc/smf/issues/250/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"url":"https://api.github.com/repos/free5gc/free5gc/issues/comments/6127958191","html_url":"https://github.com/free5gc/free5gc/issues/1186#issuecomment-6127958191","issue_url":"https://api.github.com/repos/free5gc/free5gc/issues/1186","id":6127958191,"node_id":"IC_