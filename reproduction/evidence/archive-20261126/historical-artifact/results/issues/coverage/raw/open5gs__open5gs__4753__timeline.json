icipating}","labels_url":"https://api.github.com/repos/open5gs/open5gs/labels{/name}","releases_url":"https://api.github.com/repos/open5gs/open5gs/releases{/id}","deployments_url":"https://api.github.com/repos/open5gs/open5gs/deployments","created_at":"2017-02-01T10:48:49Z","updated_at":"2026-11-05T03:05:54Z","pushed_at":"2026-11-05T00:20:37Z","git_url":"git://github.com/open5gs/open5gs.git","ssh_url":"git@github.com:open5gs/open5gs.git","clone_url":"https://github.com/open5gs/open5gs.git","svn_url":"https://github.com/open5gs/open5gs","homepage":"https://open5gs.org","size":88373,"stargazers_count":2803,"watchers_count":2803,"language":"C","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":true,"forks_count":1152,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":348,"license":{"key":"agpl-3.0","name":"GNU Affero General Public License v3.0","spdx_id":"AGPL-3.0","url":"https://api.github.com/licenses/agpl-3.0","node_id":"MDc6TGljZW5zZTE="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["3gpp","4g","5g","5gc","core","epc","lte","network","nr","open5gs"],"visibility":"public","forks":1152,"open_issues":348,"watchers":2803,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/open5gs/open5gs/pulls/4754","html_url":"https://github.com/open5gs/open5gs/pull/4754","diff_url":"https://github.com/open5gs/open5gs/pull/4754.diff","patch_url":"https://github.com/open5gs/open5gs/pull/4754.patch","merged_at":"2026-08-21T07:02:23Z"},"body":"Each Error Indication for a bearer started a new deactivation procedure. When multiple Delete Bearer transactions timed out, they sent overlapping PFCP removal requests. The first response removed the bearer, and a later response hit ogs_assert(bearer).\r\n\r\nTrack an Error Indication deactivation on the bearer and ignore duplicate reports while it is in progress. Clear the mark when the PFCP procedure is rejected or times out so that a later report can retry.\r\n\r\nRead modify_flags before resolving session-level modifications, tolerate a missing GTP transaction during local EPC session deletion, and release the whole PDN connection when a Delete Bearer request for the default bearer times out. This prevents a live EPC session from being left without a default bearer.\r\n\r\nIssues: #4753","reactions":{"url":"https://api.github.com/repos/open5gs/open5gs/issues/4754/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/open5gs/open5gs/issues/4754/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":29788509224,"node_id":"REFE_lADOBM4HkM8AAAABNp-AJc8AAAAG74iUKA","url":"https://api.github.com/repos/open5gs/open5gs/issues/events/29788509224","actor":{"login":"acetcom","id":4222492,"node_id":"MDQ6VXNlcjQyMjI0OTI=","avatar_url":"https://avatars.githubusercontent.com/u/4222492?v=4","gravatar_id":"","url":"https://api.github.com/users/acetcom","html_url":"https://github.com/acetcom","followers_url":"https://api.github.com/users/acetcom/followers","following_url":"https://api.github.com/users/acetcom/following{/other_user}","gists_url":"https://api.github.com/users/acetcom/gists{/gist_id}","starred_url":"https://api.github.com/users/acetcom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/acetcom/subscriptions","organizations_url":"https://api.github.com/users/acetcom/orgs","repos_url":"https://api.github.com/users/acetcom/repos","events_url":"https://api.github.com/users/acetcom/events{/privacy}","received_events_url":"https://api.github.com/users/acetcom/received_events","type":"User","user_view_type":"public","site_admin":false},"event":"referenced","commi