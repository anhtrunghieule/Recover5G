n5gs/git/refs{/sha}","trees_url":"https://api.github.com/repos/open5gs/open5gs/git/trees{/sha}","statuses_url":"https://api.github.com/repos/open5gs/open5gs/statuses/{sha}","languages_url":"https://api.github.com/repos/open5gs/open5gs/languages","stargazers_url":"https://api.github.com/repos/open5gs/open5gs/stargazers","contributors_url":"https://api.github.com/repos/open5gs/open5gs/contributors","subscribers_url":"https://api.github.com/repos/open5gs/open5gs/subscribers","subscription_url":"https://api.github.com/repos/open5gs/open5gs/subscription","commits_url":"https://api.github.com/repos/open5gs/open5gs/commits{/sha}","git_commits_url":"https://api.github.com/repos/open5gs/open5gs/git/commits{/sha}","comments_url":"https://api.github.com/repos/open5gs/open5gs/comments{/number}","issue_comment_url":"https://api.github.com/repos/open5gs/open5gs/issues/comments{/number}","contents_url":"https://api.github.com/repos/open5gs/open5gs/contents/{+path}","compare_url":"https://api.github.com/repos/open5gs/open5gs/compare/{base}...{head}","merges_url":"https://api.github.com/repos/open5gs/open5gs/merges","archive_url":"https://api.github.com/repos/open5gs/open5gs/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/open5gs/open5gs/downloads","issues_url":"https://api.github.com/repos/open5gs/open5gs/issues{/number}","pulls_url":"https://api.github.com/repos/open5gs/open5gs/pulls{/number}","milestones_url":"https://api.github.com/repos/open5gs/open5gs/milestones{/number}","notifications_url":"https://api.github.com/repos/open5gs/open5gs/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/open5gs/open5gs/labels{/name}","releases_url":"https://api.github.com/repos/open5gs/open5gs/releases{/id}","deployments_url":"https://api.github.com/repos/open5gs/open5gs/deployments","created_at":"2017-02-01T10:48:49Z","updated_at":"2026-11-05T03:05:54Z","pushed_at":"2026-11-05T00:20:37Z","git_url":"git://github.com/open5gs/open5gs.git","ssh_url":"git@github.com:open5gs/open5gs.git","clone_url":"https://github.com/open5gs/open5gs.git","svn_url":"https://github.com/open5gs/open5gs","homepage":"https://open5gs.org","size":88373,"stargazers_count":2803,"watchers_count":2803,"language":"C","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":true,"forks_count":1152,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":348,"license":{"key":"agpl-3.0","name":"GNU Affero General Public License v3.0","spdx_id":"AGPL-3.0","url":"https://api.github.com/licenses/agpl-3.0","node_id":"MDc6TGljZW5zZTE="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["3gpp","4g","5g","5gc","core","epc","lte","network","nr","open5gs"],"visibility":"public","forks":1152,"open_issues":348,"watchers":2803,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/open5gs/open5gs/pulls/4834","html_url":"https://github.com/open5gs/open5gs/pull/4834","diff_url":"https://github.com/open5gs/open5gs/pull/4834.diff","patch_url":"https://github.com/open5gs/open5gs/pull/4834.patch","merged_at":"2026-10-13T07:42:31Z"},"body":"Fixes #4833.\n\n`sess_5gc_timeout()` in `src/smf/pfcp-path.c` aborts the whole SMF process when a PFCP Session Deletion Request times out and the associated SBI stream has already been released (`ogs_assert(stream)` on a NULL stream).\n\nThe modification branch a few lines above already guards with `if (stream)`. This PR applies the same handling to the deletion branch: report `504 Gateway Timeout` only when the stream is still alive; otherwise log a warning and continue with the existing `SMF_EVT_N4_TIMER` session cleanup below (which is the correct behavior either way).\n\n## Why it matters\n\nWithout the guard, a recoverable PFCP timeout kills the SMF. The restart loses all in-memory UE address allocations → duplicate UE IP assignment and broken downlink for roughly half of the (re)attached sessions; under session churn it can become a self-feeding crash loop (crash → reconciliation → more timeouts → crash). We observed 4–6 restarts within one afternoon before the fix.\n\n## Verification\n\nWith this patch: full-stack reset + one-shot 600-UE attach/detach churn + mass UE kills → **zero SMF restarts** (previously 4–6 per run) and clean 1:1 UE IP allocation (600 UEs → 600 unique IPs).\n\nBacktrace for reference:\n\n```\n[pfcp] WARNING: [1289] LOCAL No Reponse. Give up! for step 1 type 54 peer [172.22.0.8]:8805 (../lib/pfcp/xact.c:640)\n[smf]  ERROR: [imsi-...:2] No PFCP session deletion response[7] (../src/smf/pfcp-path.c:330)\n[smf]  FATAL: sess_5gc_timeout: Assertion `stream' failed. (../src/smf/pfcp-path.c:341)\n[core] FATAL: backtrace() returned 8 addresses (../lib/core/ogs-abort.c:37)\n```\n","reactions":{"url":"https://api.github.com/repos/open5gs/open5gs/issues/4834/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/open5gs/open5gs/issues/4834/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":32423694993,"node_id":"REFE_lADOBM4HkM8AAAABUxHMks8AAAAHjJpSkQ","url":"https://api.github.com/repos/open5gs/open5gs/issues/events/32423694993","actor":{"login":"zhangerfei-dp","id":334437229,"node_id":"U_kgDOE-8bbQ","avatar_url":"https://avatars.githubusercontent.com/u/334437229?v=4","gravatar_id":"","url":"https://api.github.com/users/zhangerfei-dp","html_url":"https://github.com/zhangerfei-dp","followers_url":"https://api.github.com/users/zhangerfei-dp/followers","following_url":"https://api.github.com/users/zhangerfei-dp/following{/other_user}","gists_url":"https://api.github.com/users/zhangerfei-dp/gists{/gist_id}","starred_url":"https://api.github.com/users/zh