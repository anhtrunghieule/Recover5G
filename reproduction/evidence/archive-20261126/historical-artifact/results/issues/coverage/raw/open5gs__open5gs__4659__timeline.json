ub.com/repos/open5gs/open5gs/git/blobs{/sha}","git_tags_url":"https://api.github.com/repos/open5gs/open5gs/git/tags{/sha}","git_refs_url":"https://api.github.com/repos/open5gs/open5gs/git/refs{/sha}","trees_url":"https://api.github.com/repos/open5gs/open5gs/git/trees{/sha}","statuses_url":"https://api.github.com/repos/open5gs/open5gs/statuses/{sha}","languages_url":"https://api.github.com/repos/open5gs/open5gs/languages","stargazers_url":"https://api.github.com/repos/open5gs/open5gs/stargazers","contributors_url":"https://api.github.com/repos/open5gs/open5gs/contributors","subscribers_url":"https://api.github.com/repos/open5gs/open5gs/subscribers","subscription_url":"https://api.github.com/repos/open5gs/open5gs/subscription","commits_url":"https://api.github.com/repos/open5gs/open5gs/commits{/sha}","git_commits_url":"https://api.github.com/repos/open5gs/open5gs/git/commits{/sha}","comments_url":"https://api.github.com/repos/open5gs/open5gs/comments{/number}","issue_comment_url":"https://api.github.com/repos/open5gs/open5gs/issues/comments{/number}","contents_url":"https://api.github.com/repos/open5gs/open5gs/contents/{+path}","compare_url":"https://api.github.com/repos/open5gs/open5gs/compare/{base}...{head}","merges_url":"https://api.github.com/repos/open5gs/open5gs/merges","archive_url":"https://api.github.com/repos/open5gs/open5gs/{archive_format}{/ref}","downloads_url":"https://api.github.com/repos/open5gs/open5gs/downloads","issues_url":"https://api.github.com/repos/open5gs/open5gs/issues{/number}","pulls_url":"https://api.github.com/repos/open5gs/open5gs/pulls{/number}","milestones_url":"https://api.github.com/repos/open5gs/open5gs/milestones{/number}","notifications_url":"https://api.github.com/repos/open5gs/open5gs/notifications{?since,all,participating}","labels_url":"https://api.github.com/repos/open5gs/open5gs/labels{/name}","releases_url":"https://api.github.com/repos/open5gs/open5gs/releases{/id}","deployments_url":"https://api.github.com/repos/open5gs/open5gs/deployments","created_at":"2017-02-01T10:48:49Z","updated_at":"2026-11-05T03:05:54Z","pushed_at":"2026-11-05T00:20:37Z","git_url":"git://github.com/open5gs/open5gs.git","ssh_url":"git@github.com:open5gs/open5gs.git","clone_url":"https://github.com/open5gs/open5gs.git","svn_url":"https://github.com/open5gs/open5gs","homepage":"https://open5gs.org","size":88373,"stargazers_count":2803,"watchers_count":2803,"language":"C","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":true,"has_pages":true,"has_discussions":true,"forks_count":1152,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":348,"license":{"key":"agpl-3.0","name":"GNU Affero General Public License v3.0","spdx_id":"AGPL-3.0","url":"https://api.github.com/licenses/agpl-3.0","node_id":"MDc6TGljZW5zZTE="},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":["3gpp","4g","5g","5gc","core","epc","lte","network","nr","open5gs"],"visibility":"public","forks":1152,"open_issues":348,"watchers":2803,"default_branch":"main","permissions":{"admin":false,"maintain":false,"push":false,"triage":false,"pull":true}},"pull_request":{"url":"https://api.github.com/repos/open5gs/open5gs/pulls/4660","html_url":"https://github.com/open5gs/open5gs/pull/4660","diff_url":"https://github.com/open5gs/open5gs/pull/4660.diff","patch_url":"https://github.com/open5gs/open5gs/pull/4660.patch","merged_at":"2026-07-01T11:05:58Z"},"body":"On a GTP-U Error Indication for an EPC session, the SMF deleted the whole PFCP session for any Error Indication and never notified the MME. A single transient, handover-induced Error Indication on a dedicated (voice) bearer therefore tore down the entire IMS PDN, and because no Delete Bearer Request was sent to the MME, the MME and UE kept a stale IMS PDN connection - the UE could not place a new VoLTE call until it re-attached.\r\n\r\nSMF (src/smf/n4-handler.c, src/smf/pfcp-path.c):\r\nMap the Error Indication FAR to its bearer and run a PGW-initiated bearer deactivation instead of a blind session deletion, per 3GPP TS 23.007:\r\n  - dedicated bearer -> deactivate only that bearer (IMS PDN survives);\r\n  - default bearer   -> deactivate the whole PDN connection.\r\nsmf_gtp2_send_delete_bearer_request() sets the Linked EBI (default) or the\r\nEPS Bearer ID (dedicated), so the MME deactivates the EPS bearer toward the\r\nUE and stays in sync. The PFCP session is deleted on the Delete Bearer\r\nResponse (wait_pfcp_deletion). The default-bearer case uses cause\r\n\"Reactivation requested\" so the UE re-establishes the PDN.\r\n\r\nMME (src/mme/mme-s11-handler.c, mme-path.c, mme-context.h, nas-path.c, nas-path.h, esm-sm.c):\r\nMap the GTPv2 Cause \"Reactivation requested\" (#8) on a default-bearer Delete Bearer Request to NAS ESM cause #39 \"reactivation requested\" (TS 29.274 Table C.3) so the UE re-establishes the IMS PDN. The mapping is restricted to the default bearer (Linked EBI). Carry the ESM cause across paging in mme_ue->paging.esm_cause so an ECM-IDLE UE also receives it after paging; previously the post-paging path always used REGULAR_DEACTIVATION.\r\n\r\nThe TS 29.274 Table C.3 \"re-attach required\" mapping for the last PDN connection is intentionally not implemented (Attach without PDN connectivity and SCEF PDN connections are not supported here); the last default bearer is deactivated with ESM cause #39 as well.\r\n\r\nIssues: #4659","reactions":{"url":"https://api.github.com/repos/open5gs/open5gs/issues/4660/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/open5gs/open5gs/issues/4660/timeline","performed_via_github_app":null,"state_reason":null}},"event":"cross-referenced"},{"id":27424642606,"node_id":"REFE_lADOBM4HkM8AAAABHTOSM88AAAAGYqLWLg","url":"https://api.github.com/repos/open5gs/open5gs/issues/events/27424642606