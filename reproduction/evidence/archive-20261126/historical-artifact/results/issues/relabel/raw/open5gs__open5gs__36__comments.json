gs/open5gs/issues/comments/373300836/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/373307699","html_url":"https://github.com/open5gs/open5gs/issues/36#issuecomment-373307699","issue_url":"https://api.github.com/repos/open5gs/open5gs/issues/36","id":373307699,"node_id":"MDEyOklzc3VlQ29tbWVudDM3MzMwNzY5OQ==","user":{"login":"acetcom","id":4222492,"node_id":"MDQ6VXNlcjQyMjI0OTI=","avatar_url":"https://avatars.githubusercontent.com/u/4222492?v=4","gravatar_id":"","url":"https://api.github.com/users/acetcom","html_url":"https://github.com/acetcom","followers_url":"https://api.github.com/users/acetcom/followers","following_url":"https://api.github.com/users/acetcom/following{/other_user}","gists_url":"https://api.github.com/users/acetcom/gists{/gist_id}","starred_url":"https://api.github.com/users/acetcom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/acetcom/subscriptions","organizations_url":"https://api.github.com/users/acetcom/orgs","repos_url":"https://api.github.com/users/acetcom/repos","events_url":"https://api.github.com/users/acetcom/events{/privacy}","received_events_url":"https://api.github.com/users/acetcom/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-03-15T09:07:53Z","updated_at":"2018-03-15T09:07:53Z","body":"I'm not sure why you set the 10.0.102.18 in enp2s0.\r\n\r\nBTW, could you send me a configuration file(`nextepc.conf`) and log file(`nextepc.log`)?\r\nAnd also, I need a result of `ifconfig -a`.\r\n\r\nThanks!\r\n","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/373307699/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/373312177","html_url":"https://github.com/open5gs/open5gs/issues/36#issuecomment-373312177","issue_url":"https://api.github.com/repos/open5gs/open5gs/issues/36","id":373312177,"node_id":"MDEyOklzc3VlQ29tbWVudDM3MzMxMjE3Nw==","user":{"login":"lsps4111wu","id":17041421,"node_id":"MDQ6VXNlcjE3MDQxNDIx","avatar_url":"https://avatars.githubusercontent.com/u/17041421?v=4","gravatar_id":"","url":"https://api.github.com/users/lsps4111wu","html_url":"https://github.com/lsps4111wu","followers_url":"https://api.github.com/users/lsps4111wu/followers","following_url":"https://api.github.com/users/lsps4111wu/following{/other_user}","gists_url":"https://api.github.com/users/lsps4111wu/gists{/gist_id}","starred_url":"https://api.github.com/users/lsps4111wu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lsps4111wu/subscriptions","organizations_url":"https://api.github.com/users/lsps4111wu/orgs","repos_url":"https://api.github.com/users/lsps4111wu/repos","events_url":"https://api.github.com/users/lsps4111wu/events{/privacy}","received_events_url":"https://api.github.com/users/lsps4111wu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-03-15T09:24:22Z","updated_at":"2018-03-15T09:29:11Z","body":"The reason why I set that is\r\nenp2s0 is NIC that connect to eNB\r\nenp5s0 is NIC that connect to Internet\r\n\r\nifconfig -a result:\r\n![image](https://user-images.githubusercontent.com/17041421/37454454-9672bf78-2875-11e8-8405-b980e936b391.png)\r\n\r\nThe attached files are:\r\nnextepc.log & nextepc.conf : the file you requested\r\nsometimes_can_ping_google_DNS.pcapng &(log)sometimes_can_ping_google_DNS.txt : \r\nI move between eNBs and find out that sometimes(not always) the ping will reply OK for a short time,\r\n(the situation seems to happen when handover)\r\nbut I don't know why.\r\n[files1.zip](https://github.com/acetcom/nextepc/files/1814688/files1.zip)\r\n\r\nThanks a lot!","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/373312177/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/373359716","html_url":"https://github.com/open5gs/open5gs/issues/36#issuecomment-373359716","issue_url":"https://api.github.com/repos/open5gs/open5gs/issues/36","id":373359716,"node_id":"MDEyOklzc3VlQ29tbWVudDM3MzM1OTcxNg==","user":{"login":"acetcom","id":4222492,"node_id":"MDQ6VXNlcjQyMjI0OTI=","avatar_url":"https://avatars.githubusercontent.com/u/4222492?v=4","gravatar_id":"","url":"https://api.github.com/users/acetcom","html_url":"https://github.com/acetcom","followers_url":"https://api.github.com/users/acetcom/followers","following_url":"https://api.github.com/users/acetcom/following{/other_user}","gists_url":"https://api.github.com/users/acetcom/gists{/gist_id}","starred_url":"https://api.github.com/users/acetcom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/acetcom/subscriptions","organizations_url":"https://api.github.com/users/acetcom/orgs","repos_url":"https://api.github.com/users/acetcom/repos","events_url":"https://api.github.com/users/acetcom/events{/privacy}","received_events_url":"https://api.github.com/users/acetcom/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-03-15T12:30:18Z","updated_at":"2018-03-15T12:30:18Z","body":"Your configuration might be good. There are 3 or 4 eNodeBs. Right?\r\n\r\nBut, Handover is not initiated.  Just Tracking area update is performed.\r\n`ping will reply OK sometimes` means that your iptables configuration is also correct.\r\n\r\nSo, for verifying your environment, how about use only 1 eNodeB and 1 UE?\r\nNevertheless, if the ping is not working, please change the `gtp` trace level to `5`.\r\nIf we can get the log with `gtp` trace level 5, we can see the reason more clearly.\r\n\r\nThank you for your effort.","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/373359716/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/373582044","html_url":"https://github.com/open5gs/open5gs/issues/36#issuecomment-373582044","issue_url":"https://api.github.com/repos/open5gs/open5gs/issues/36","id":373582044,"node_id":"MDEyOklzc3VlQ29tbWVudDM3MzU4MjA0NA==","user":{"login":"lsps4111wu","id":17041421,"node_id":"MDQ6VXNlcjE3MDQxNDIx","avatar_url":"https://avatars.githubusercontent.com/u/17041421?v=4","gravatar_id":"","url":"https://api.github.com/users/lsps4111wu","html_url":"https://github.com/lsps4111wu","followers_url":"https://api.github.com/users/lsps4111wu/followers","following_url":"https://api.github.com/users/lsps4111wu/following{/other_user}","gists_url":"https://api.github.com/users/lsps4111wu/gists{/gist_id}","starred_url":"https://api.github.com/users/lsps4111wu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lsps4111wu/subscriptions","organizations_url":"https://api.github.com/users/lsps4111wu/orgs","repos_url":"https://api.github.com/users/lsps4111wu/repos","events_url":"https://api.github.com/users/lsps4111wu/events{/privacy}","received_events_url":"https://api.github.com/users/lsps4111wu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2018-03-16T02:14:20Z","updated_at":"2018-03-16T02:14:20Z","body":"Good morning,\r\nGood news for 1 eNB and 1UE can connect to the Internet.\r\nFor 2 eNBs or more still can't surf the Internet.\r\n\r\n1 eNB [03/16 09:09:18.609]\r\n2 eNBs [03/16 09:58:11.073]\r\n[nextepc.log](https://github.co