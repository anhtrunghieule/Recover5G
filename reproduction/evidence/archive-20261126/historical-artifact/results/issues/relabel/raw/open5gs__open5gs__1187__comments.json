api.github.com/users/maikerushimu/following{/other_user}","gists_url":"https://api.github.com/users/maikerushimu/gists{/gist_id}","starred_url":"https://api.github.com/users/maikerushimu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/maikerushimu/subscriptions","organizations_url":"https://api.github.com/users/maikerushimu/orgs","repos_url":"https://api.github.com/users/maikerushimu/repos","events_url":"https://api.github.com/users/maikerushimu/events{/privacy}","received_events_url":"https://api.github.com/users/maikerushimu/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-04-19T06:10:55Z","updated_at":"2022-04-19T06:10:55Z","body":"@ashiqpathan \r\n> Hi can you please explain how to add BSF? I am also facing the same problem. Thanks\r\n\r\nI was using dockerized version of open5gs. To add bsf, i simply add it to my docker-compose.yaml file.\r\nI followed reference from this URL: https://github.com/herlesupreeth/docker_open5gs/blob/master/docker-compose.yaml ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/1102130809/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/1133486139","html_url":"https://github.com/open5gs/open5gs/issues/1187#issuecomment-1133486139","issue_url":"https://api.github.com/repos/open5gs/open5gs/issues/1187","id":1133486139,"node_id":"IC_kwDOBM4HkM5Dj6A7","user":{"login":"Vomvas","id":43212303,"node_id":"MDQ6VXNlcjQzMjEyMzAz","avatar_url":"https://avatars.githubusercontent.com/u/43212303?v=4","gravatar_id":"","url":"https://api.github.com/users/Vomvas","html_url":"https://github.com/Vomvas","followers_url":"https://api.github.com/users/Vomvas/followers","following_url":"https://api.github.com/users/Vomvas/following{/other_user}","gists_url":"https://api.github.com/users/Vomvas/gists{/gist_id}","starred_url":"https://api.github.com/users/Vomvas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Vomvas/subscriptions","organizations_url":"https://api.github.com/users/Vomvas/orgs","repos_url":"https://api.github.com/users/Vomvas/repos","events_url":"https://api.github.com/users/Vomvas/events{/privacy}","received_events_url":"https://api.github.com/users/Vomvas/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-05-21T00:47:46Z","updated_at":"2022-05-21T00:47:46Z","body":"**TL;DR:** The following issues do not exist in the latest commit. My question is:\r\n\r\nIs there a way to get this latest commit (or even the v2.4.5 commit, see below) through the package manager, just for convenience?\r\n\r\nThanks!\r\n\r\n----------------------\r\n\r\nI am encountering a very similar issue after a clean installation on Ubuntu 22.04, of UERANSIM and Open5GS v2.4.6 (from the package manager; BSF is running normally).\r\n\r\n### Problem 1\r\nAMF logs:\r\n<img width=\"1071\" alt=\"image\" src=\"https://user-images.githubusercontent.com/43212303/169627412-58c0da7f-d225-416b-9a57-bf79d8028793.png\">\r\n\r\nUE sets up TUN interface successfully:\r\n![image](https://user-images.githubusercontent.com/43212303/169626003-41a784ae-ec4c-45b2-b628-0cfd8b7f6a21.png)\r\n\r\n### Problem 2\r\nOn another same setup on Ubuntu 20.04 (Open5GS v2.4.5) I had a very similar issue, but UE registration wouldn't complete:\r\n\r\n<img width=\"971\" alt=\"image\" src=\"https://user-images.githubusercontent.com/43212303/169626158-8a8cce1e-07ba-4efa-ac8f-25c73b12398b.png\">\r\n\r\nFinally, on  a third same setup on Ubuntu 20.04 (Open5GS v2.4.5) the UE remained registered without problems.\r\n\r\nBuilding 2.4.5 (da8c93432645f4a89dab3c36c50d99c575965a7c) from source solved Problem 2.\r\nBuilding 2.4.6 (b6fe6406418650aa0581e52f7b4b11e3276ba78a) from source solved Problems 1 and 2.","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/1133486139/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/1133487301","html_url":"https://github.com/open5gs/open5gs/issues/1187#issuecomment-1133487301","issue_url":"https://api.github.com/repos/open5gs/open5gs/issues/1187","id":1133487301,"node_id":"IC_kwDOBM4HkM5Dj6TF","user":{"login":"acetcom","id":4222492,"node_id":"MDQ6VXNlcjQyMjI0OTI=","avatar_url":"https://avatars.githubusercontent.com/u/4222492?v=4","gravatar_id":"","url":"https://api.github.com/users/acetcom","html_url":"https://github.com/acetcom","followers_url":"https://api.github.com/users/acetcom/followers","following_url":"https://api.github.com/users/acetcom/following{/other_user}","gists_url":"https://api.github.com/users/acetcom/gists{/gist_id}","starred_url":"https://api.github.com/users/acetcom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/acetcom/subscriptions","organizations_url":"https://api.github.com/users/acetcom/orgs","repos_url":"https://api.github.com/users/acetcom/repos","events_url":"https://api.github.com/users/acetcom/events{/privacy}","received_events_url":"https://api.github.com/users/acetcom/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2022-05-21T00:53:19Z","updated_at":"2022-05-21T00:53:55Z","body":"@Vomvas \r\n\r\nI have no plan to provide old version package at this point.\r\n\r\nWhen you run into problems, the best way is to post them on a github issue. If I suspect a bug, I will fix the problem immediately and release a new package.\r\n\r\nSorry for not helping this!\r\nSukchan","author_association":"MEMBER","pin":null,"reactions":{"url":"https://api.github.com/repos/open5gs/open5gs/issues/comments/11